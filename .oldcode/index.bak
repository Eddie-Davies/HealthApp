// Import and setup express module for http requests.
const express = require('express');
const app = express();
const port = 5000;

// Import and connect to MongoDB
const mongoose = require('mongoose');
const mongoURI = 'mongodb://127.0.0.1:27017/health-app'
mongoose.connect(mongoURI)

// Define user schema
const UserSchema = mongoose.mongoose.Schema({
    firstName: String,
    lastName: String,
    age: Number,
    email: String,
    gender: Boolean,
    weight: Number,
    targetWeight: Number
})

const UserModel = mongoose.model("users", UserSchema);

app.get("/getUsers", (req, res) =>{
    UserModel.find({}).then(function(users) {
        res.json(users)
    }).catch(function(err){
        console.log(err)
    })
})

// Test at root
app.get('/', (req, res) => {
    res.send('Hello from the backend!');
  });
  

// Server launch log
app.listen(port, () => {
    console.log(`✨ BACKEND: Node.js server running at http://localhost:${port} ✨`);
  });

  